# Environment variables for Docker Compose
# Copy this file to .env and update with your values

# PostgreSQL Configuration
POSTGRES_DB=synapse
POSTGRES_USER=synapse
POSTGRES_PASSWORD=change_this_secure_password_123!
POSTGRES_INITDB_ARGS=--encoding=UTF8 --locale=C

# Synapse Configuration
SYNAPSE_SERVER_NAME=stg-adm-im-ma.bservices-api.org.pk
SYNAPSE_REPORT_STATS=no
SYNAPSE_CONFIG_PATH=/data/homeserver.yaml

# Redis Configuration (if using password)
# REDIS_PASSWORD=your_redis_password_here

# Nginx Configuration (if using)
# SSL_CERTIFICATE_PATH=/etc/ssl/certs/stg-adm-im-ma.bservices-api.org.pk.crt
# SSL_CERTIFICATE_KEY_PATH=/etc/ssl/private/stg-adm-im-ma.bservices-api.org.pk.key

# RADIUS Configuration (if using)
# RADIUS_HOST=radius
# RADIUS_PORT=1812
# RADIUS_SECRET=testing123

# Timezone
TZ=UTC

# Docker Compose Project Name
COMPOSE_PROJECT_NAME=synapse
